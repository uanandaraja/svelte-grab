{
  "name": "@uanandaraja/sveltegrab",
  "version": "0.0.2",
  "private": false,
  "description": "Dev-only element grabber for Svelte and SvelteKit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uanandaraja/svelte-grab.git"
  },
  "homepage": "https://github.com/uanandaraja/svelte-grab",
  "bugs": {
    "url": "https://github.com/uanandaraja/svelte-grab/issues"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "vite",
    "devtools",
    "inspect"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/auto.ts --dts --format esm --clean"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
